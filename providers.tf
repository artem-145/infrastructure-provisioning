# =============================================================================
# providers.tf
# Настройка провайдера Yandex Cloud.
#
# ВАЖНО: никаких секретов в коде! Аутентификация выполняется через
# переменные окружения (рекомендуемый способ):
#   export YC_TOKEN="<OAuth-токен или IAM-токен>"
# или через файл ключа сервисного аккаунта:
#   export YC_SERVICE_ACCOUNT_KEY_FILE="/path/to/key.json"
# =============================================================================

provider "yandex" {
  # Идентификатор облака (передаётся через переменную).
  cloud_id = var.cloud_id

  # Идентификатор каталога (передаётся через переменную).
  folder_id = var.folder_id

  # Зона доступности по умолчанию.
  zone = var.zone
}