# =============================================================================
# .gitignore
# Исключаем секреты, файлы состояния Terraform и временные файлы.
# =============================================================================

# --- Terraform state и lock-файлы -------------------------------------------
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# --- Каталог провайдеров и модулей ------------------------------------------
.terraform/

# --- Файлы переменных с реальными значениями (секреты) ----------------------
# Игнорируем все .tfvars, кроме примера.
*.tfvars
!terraform.tfvars.example

# Файлы автоматических переменных.
*.auto.tfvars

# --- Override-файлы ----------------------------------------------------------
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Логи и временные файлы -------------------------------------------------
crash.log
crash.*.log
*.log
*.tmp
.DS_Store

# --- Файлы окружения с секретами --------------------------------------------
.env
.env.*